{
  "dataset_path": "data/kredivo_reviews_50k.csv",
  "text_column": "content",
  "id_column": "reviewId",
  "validation_size": 0.1,
  "test_size": 0.1,
  "random_state": 42,
  "max_fit_docs": 12000,
  "transform_batch_size": 512,
  "embedding_model": "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2",
  "device": "cpu",
  "min_topic_size": 30,
  "umap_n_neighbors": 15,
  "umap_n_components": 5,
  "n_keywords": 12,
  "summary_sentences": 5,
  "mmr_lambda": 0.72,
  "textrank_neighbors": 15,
  "reference_topics": 30,
  "reference_examples_per_topic": 15,
  "audit_sample_size": 200,
  "audit_min_agreement": 0.8,
  "stopword_removal": true,
  "save_topic_model": true,
  "audit_min_class_agreement": 0.7,
  "audit_min_class_support": 10,
  "inference_min_similarity": 0.42
}
